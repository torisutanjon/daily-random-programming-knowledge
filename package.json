{
  "name": "drpk",
  "version": "0.1.0",
  "private": true,
  "description": "Daily Random Programming Knowledge",
  "author": "Tristan John Girao",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "type-check": "next typegen && tsc --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json",
    "dist": "next build && node scripts/prepare-standalone.mjs && tsc -p electron/tsconfig.json && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.drpk.app",
    "productName": "drpk",
    "directories": {
      "buildResources": "electron/assets",
      "output": "dist"
    },
    "files": [
      "dist-electron/**",
      "electron/assets/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "include": "electron/assets/installer.nsh"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22"
}
